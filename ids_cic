    "from sklearn.metrics import precision_score, recall_score\n",
    "\n",
    "# 1) Prepare Wednesday (reuse cleaned data) and Friday with unified labels\n",
    "wed = df.copy()\n",
    "wed = wed[wed['Label'] != 'Heartbleed']\n",
    "fri2 = fri.copy()\n",
    "fri2['Label'] = fri2['Label'].replace({'BENIGN': 'BENIGN', 'DDoS': 'DDoS'})\n",
    "\n",
    "combined = pd.concat([wed.assign(day='Wed'), fri2.assign(day='Fri')], ignore_index=True)\n",
    "combined['Timestamp'] = pd.to_datetime(combined['Timestamp'], errors='coerce')\n",
    "combined = combined.dropna(subset=['Timestamp'])\n",
    "\n",
    "# 2) Time-based split inside each day: first 70% of time -> train, last 30% -> test\n",
    "def time_split(g, frac=0.7):\n",
    "    g = g.sort_values('Timestamp')\n",
    "    cut = int(len(g) * frac)\n",
    "    g['is_train'] = [True] * cut + [False] * (len(g) - cut)\n",
    "    return g\n",
    "\n",
    "combined = combined.groupby('day', group_keys=False).apply(time_split)\n",
    "\n",
    "feature_cols = list(X_tr.columns)\n",
    "Xc = combined[feature_cols].astype('float32')\n",
    "yc = combined['Label']\n",
    "\n",
    "le2 = LabelEncoder()\n",
    "yc_enc = le2.fit_transform(yc)\n",
    "print(\"Classes:\", list(le2.classes_))\n",
    "\n",
    "Xtr2, ytr2 = Xc[combined['is_train']], yc_enc[combined['is_train'].values]\n",
    "Xte2, yte2 = Xc[~combined['is_train']], yc_enc[~combined['is_train'].values]\n",
    "print(\"Train:\", Xtr2.shape, \"| Test:\", Xte2.shape)\n",
    "\n",
    "# 3) Train and evaluate\n",
    "rf2 = RandomForestClassifier(n_estimators=100, n_jobs=-1, random_state=42)\n",
    "rf2.fit(Xtr2, ytr2)\n",
    "p2 = rf2.predict(Xte2)\n",
    "\n",
    "print(\"\\nAccuracy: %.4f | Macro F1: %.4f\" % (accuracy_score(yte2, p2), f1_score(yte2, p2, average='macro')))\n",
    "print(classification_report(yte2, p2, target_names=le2.classes_, zero_division=0))\n",
    "print(\"Confusion matrix:\")\n",
    "print(confusion_matrix(yte2, p2))"
