    "parts_tr, parts_te = [], []\n",
    "for lbl, g in combined.groupby('Label'):\n",
    "    g = g.sort_values('Timestamp')\n",
    "    cut = int(len(g) * 0.7)\n",
    "    parts_tr.append(g.iloc[:cut])\n",
    "    parts_te.append(g.iloc[cut:])\n",
    "\n",
    "tr = pd.concat(parts_tr)\n",
    "te = pd.concat(parts_te)\n",
    "\n",
    "Xtr3 = tr[feature_cols].astype('float32')\n",
    "Xte3 = te[feature_cols].astype('float32')\n",
