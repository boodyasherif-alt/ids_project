    "# 1) Clean: infinities / NaN / duplicates\n",
    "df = df.replace([np.inf, -np.inf], np.nan)\n",
    "print(\"Rows with NaN/inf:\", df.isnull().any(axis=1).sum())\n",
    "df = df.dropna().drop_duplicates().reset_index(drop=True)\n",
    "print(\"After cleaning:\", df.shape)\n",
    "\n",
    "# 2) Keep identifying info aside (for the alert only, NOT for training)\n",
    "meta = df[['Flow ID', 'Source IP', 'Source Port', 'Destination IP', 'Destination Port', 'Timestamp']].copy()\n",
    "\n",
    "# 3) Group labels (Heartbleed has only 11 rows -> merge into 'Other DoS')\n",
    "label_map = {\n",
